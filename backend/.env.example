DATABASE_URL=postgresql://regalitos:regalitos@localhost:5532/regalitos
DB_POOL_SIZE=10
PORT=8080
JWT_SECRET=generá-uno-con-openssl-rand-hex-32
ADMIN_EMAIL=admin@regalitos.local
ADMIN_PASSWORD=cambiar123

# Producción: APP_ENV=production hace que el servidor NO arranque con secretos de ejemplo,
# con la clave de ejemplo de la base o sin HTTPS en APP_URL.
# APP_ENV=production
# POSTGRES_PASSWORD=   (docker compose; usar la misma en DATABASE_URL)
# COOKIE_SECURE=1      (por defecto se activa solo si APP_URL empieza con https://)
# ALLOW_REGISTRATION=true   (false desactiva /register)

# Recuperación de contraseña. APP_URL es la dirección pública con la que se arma el enlace.
# Sin MAIL_PROVIDER, MAIL_API_KEY y MAIL_FROM no se envía correo. Con MAIL_PROVIDER=log
# (solo pruebas locales) el enlace se escribe en la salida del servidor; si no, nunca.
APP_URL=http://localhost:8080
# MAIL_PROVIDER=resend
# MAIL_API_KEY=
# MAIL_FROM=Regalitos <no-reply@tudominio.com>
